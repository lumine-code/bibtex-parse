issn = {0733-947X},
keywords = {Count data,Crash analysis,Data analysis,Quantile regression,Semiparametric model,Statistics,Traffic accidents},
number = {2001},
pages = {04013025},
title = {{Analysis of Crash Data Using Quantile Regression for Counts}},
