file = {:C$\backslash$:/Users/demo-user/Documents/Mendeley/Du Student, Hickman - 2012 - Estimating a Road Mask to Improve Vehicle Detection and Tracking in Airborne Imagery.pdf:pdf},
issn = {03611981},
title = {{Estimating a Road Mask to Improve Vehicle Detection and Tracking in Airborne Imagery}},
year = {2012}
}
