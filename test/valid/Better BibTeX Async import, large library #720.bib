booktitle = {Transportation Research Board, 94th Annual Meeting},
doi = {10.3141/2477-02},
file = {:C$\backslash$:/Users/demo-user/Documents/Mendeley/Gong, Adams, Wang - 2015 - Estimating Link Travel Time with Sparse GPS Data on Highway Corridors.pdf:pdf},
