booktitle = {Transportation Research Board, 90th Annual Meeting},
file = {:C$\backslash$:/Users/demo-user/Documents/Mendeley/Krizek et al. - 2011 - Sampling Issues in Nonmotorized Travel Surveys The PABS (Pedestrian and Bicycling 1 Survey) Approach 2 3.pdf:pdf},
