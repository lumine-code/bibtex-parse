title = {{Bike lanes and other determinants of capital bikeshare trips}},
url = {http://scholar.google.com/scholar?hl=en{\&}btnG=Search{\&}q=intitle:Bike+Lanes+and+Other+Determinants+of+Capital+Bikeshare+Trips{\#}0},
year = {2012}
