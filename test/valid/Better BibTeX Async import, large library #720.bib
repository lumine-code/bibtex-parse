number = {July},
pages = {33--41},
title = {{Development of Key Performance Indicator to Compare Regularity of Service Between Urban Bus Operators}},
url = {http://trrjournalonline.trb.org/doi/10.3141/2216-04},
volume = {2216},
year = {2011}
}
