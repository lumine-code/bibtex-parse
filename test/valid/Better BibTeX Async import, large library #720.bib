pages = {18p},
title = {{Safety {\{}Indicators{\}} for {\{}Skateboarding{\}} on {\{}Transportation{\}} {\{}Facilities{\}} and as a {\{}Mode{\}} of {\{}Travel{\}} - {\{}A{\}} look at {\{}Enigmatic{\}} {\{}Injury{\}}, {\{}Fatality{\}}, and {\{}Incident{\}} {\{}Data{\}}}},
