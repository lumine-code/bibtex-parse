isbn = {6174943178},
title = {{A Framework for Considering Climate Change Adaptation and Mitigation in 1 Transportation and Land Use Scenario Planning: an Interagency Pilot Project on Cape 2 Cod 3 4 Submission}},
year = {2012}
}
