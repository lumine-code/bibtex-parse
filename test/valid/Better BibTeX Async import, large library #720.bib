issn = {0361-1981},
keywords = {Bicycle commuting,Bicycle facilities,Bicycling},
number = {2468},
pages = {20p},
title = {{Modeling the Impacts of Bicycle Facilities on Commute and Recreational Bicycling in Los Angeles County}},
