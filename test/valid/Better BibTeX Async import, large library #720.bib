issn = {0361-1981},
pages = {31--38},
title = {{GPS and Driver Log-Based Survey of Grocery Trucks in Chicago, Illinois}},
url = {http://dx.doi.org/10.3141/2410-04},
volume = {2410},
year = {2014}
}
