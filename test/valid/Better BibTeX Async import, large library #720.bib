issn = {0361-1981},
pages = {102--110},
title = {{Smartphone-Based Survey for Real-Time and Retrospective Happiness Related to Travel and Activities}},
url = {http://trrjournalonline.trb.org/doi/10.3141/2566-11},
volume = {2566},
year = {2016}
