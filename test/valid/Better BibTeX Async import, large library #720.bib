file = {:C$\backslash$:/Users/demo-user/Documents/Mendeley/Pravinvongvuth, Loudon, Planning Manager - 2011 - Development and Application of the First Large-Scale Hybrid Meso-Microsimulation Model.pdf:pdf},
keywords = {Hybrid Simulation Model,ITS Traffic Simulators,Mesosimulation,Microsimulation},
title = {{Development and Application of the First Large-Scale Hybrid Meso-Microsimulation Model in Practice}},
year = {2011}
