file = {:C$\backslash$:/Users/demo-user/Documents/Mendeley/Zoepf et al. - 2013 - Charging choices and fuel displacement in a large-scale plug-in hybrid electric vehicle demonstration.pdf:pdf},
isbn = {9788578110796},
