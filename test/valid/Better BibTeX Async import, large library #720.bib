file = {:C$\backslash$:/Users/demo-user/Documents/Mendeley/Abbas, Chong - 2013 - Car-Following Trajectory Modeling with Machine Learning- A Showcase for the Merits of Artificial Intelligence.pdf:pdf},
title = {{Car-Following Trajectory Modeling with Machine Learning- A Showcase for the Merits of Artificial Intelligence}},
