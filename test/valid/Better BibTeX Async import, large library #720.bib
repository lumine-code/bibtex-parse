pages = {31--40},
title = {{Traveler Perspectives of Greenway Quality in Northern New England}},
url = {http://trb.metapress.com/openurl.asp?genre=article{\&}id=doi:10.3141/2314-05},
volume = {2314},
year = {2012}
}
