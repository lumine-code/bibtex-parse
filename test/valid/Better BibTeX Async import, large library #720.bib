isbn = {1877-0428},
issn = {18770428},
keywords = {Bike Sharing Systems,Sustainable transportation,active mobility},
pages = {253--262},
title = {{Dimensioning of a Bike Sharing System (BSS): A Study Case in Nezahualcoyotl, Mexico}},
