file = {:C$\backslash$:/Users/demo-user/Documents/Mendeley/Langerudi et al. - 2016 - Resolution of Activity Scheduling Conflicts Reverse Pairwise Comparison of In-Home and Out-of-Home Activities.pdf:pdf},
