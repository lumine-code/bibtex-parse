isbn = {1865946133},
pages = {18},
title = {{Fuel Consumption and Cost Savings of Class 8 Heavy-Duty Trucks Powered by Natural Gas}},
url = {http://docs.trb.org/prp/13-2945.pdf},
volume = {543},
year = {2013}
