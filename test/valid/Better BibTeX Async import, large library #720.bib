booktitle = {Transportation Research Board, 90th Annual Meeting},
doi = {10.3141/2215-09},
file = {:C$\backslash$:/Users/demo-user/Documents/Mendeley/Zhang, Lu - 2011 - Short-term Freeway Traffic Flow Prediction Combining Seasonal Autoregressive Integrated Moving Average and Support Ve.pdf:pdf},
isbn = {0258379286},
