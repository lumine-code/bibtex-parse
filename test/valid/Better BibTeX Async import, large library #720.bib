title = {{Megaregion network simulation for evacuation analysis}},
url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84897047956{\&}partnerID=40{\&}md5=c7c6ba961ea6b0609cbd8950be23f64f},
