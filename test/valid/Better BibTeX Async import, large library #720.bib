eprint = {arXiv:1011.1669v3},
file = {:C$\backslash$:/Users/demo-user/Documents/Mendeley/J{\"{a}}ggi et al. - 2014 - Comparison of estimates of travel time losses on high capacity roads.pdf:pdf},
isbn = {9788578110796},
issn = {1098-6596},
keywords = {Autostrady,HBS,Nat{\c{e}}{\.{z}}enie ruchu},
pmid = {25246403},
title = {{Comparison of estimates of travel time losses on high capacity roads}},
year = {2014}
