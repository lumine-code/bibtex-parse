doi = {10.3141/2436-12},
file = {:C$\backslash$:/Users/demo-user/Documents/Mendeley/Kraus, Quiroga, Le - 2014 - Strategies to Optimize the Management of Right-of-Way Parcel and Utility Information.pdf:pdf},
isbn = {03611981 (ISSN); 9780309295345 (ISBN)},
issn = {0361-1981},
number = {2436},
pages = {119--128},
title = {{Strategies to Optimize the Management of Right-of-Way Parcel and Utility Information}},
