author = {Bettman, James R. and Zins, Michel A.},
doi = {10.1086/208757},
file = {:C$\backslash$:/Users/demo-user/Documents/Mendeley/Bettman, Zins - 1979 - Information Format and Choice Task Effects in Decision Making.pdf:pdf},
isbn = {00935301},
issn = {0093-5301},
journal = {Journal of Consumer Research},
