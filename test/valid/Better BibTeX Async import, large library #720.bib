isbn = {1765496799},
issn = {0361-1981},
number = {October 2015},
pages = {18--27},
title = {{Optimal Heterogeneous Sensor Deployment Strategy for Dynamic Origin–Destination Demand Estimation}},
url = {http://trrjournalonline.trb.org/doi/10.3141/2567-03},
volume = {2567},
year = {2016}
