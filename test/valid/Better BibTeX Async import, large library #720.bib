file = {:C$\backslash$:/Users/demo-user/Documents/Mendeley/Iswalt et al. - 2011 - Innovative BRT Operating Solutions through a Congested Segment in San Jose.pdf:pdf},
title = {{Innovative BRT Operating Solutions through a Congested Segment in San Jose}},
year = {2011}
}
