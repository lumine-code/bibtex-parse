{
  "name": "@lumine-code/bibtex-parse",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Parses BibTeX and BibLaTeX into structured JavaScript data.",
  "repository": "https://github.com/lumine-code/bibtex-parse",
  "bugs": "https://github.com/lumine-code/bibtex-parse/issues",
  "homepage": "https://github.com/lumine-code/bibtex-parse/",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "peggy --format commonjs --output lib/parser.js src/bibtex.peggy",
    "test": "jasmine",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.4.1",
    "globals": "^17.13.0",
    "jasmine": "^7.0.0",
    "peggy": "^5.1.0",
    "prettier": "^3.9.9"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "files": [
    "lib"
  ],
  "license": "MIT",
  "keywords": [
    "bibtex",
    "biblatex",
    "bibliography",
    "parser",
    "citation",
    "lumine"
  ]
}
